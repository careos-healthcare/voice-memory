{
  "schemaVersion": 1,
  "policyVersion": "2026-08-01",
  "flows": [
    {
      "id": "typed_entry",
      "dataCategory": "user_journal_text",
      "origin": "user",
      "destination": "canonical_saved_moment",
      "storageLocation": "encrypted_app_private_journal",
      "encryptionState": "encrypted_at_rest",
      "ownerScope": "archive_and_account",
      "retention": "until_user_deletes",
      "deletionHandler": "journal_and_account_deletion",
      "consentOrDisclosure": "direct_user_action",
      "analyticsProhibited": true,
      "externalProcessor": null,
      "productionCapability": "encrypted_local_journal",
      "tests": ["apps/voicememory_mobile/test/journal_store_test.dart"]
    },
    {
      "id": "temporary_plaintext_audio",
      "dataCategory": "voice_recording",
      "origin": "microphone",
      "destination": "encrypted_audio_vault",
      "storageLocation": "app_private_no_backup_temporary_directory",
      "encryptionState": "plaintext_during_capture_and_recovery_only",
      "ownerScope": "archive_and_account",
      "retention": "maximum_24_hours",
      "deletionHandler": "sensitive_temporary_audio_store",
      "consentOrDisclosure": "microphone_permission",
      "analyticsProhibited": true,
      "externalProcessor": null,
      "productionCapability": "protected_temporary_audio",
      "tests": ["apps/voicememory_mobile/test/services/privacy/sensitive_temporary_audio_store_test.dart"]
    },
    {
      "id": "encrypted_audio_vault",
      "dataCategory": "voice_recording",
      "origin": "temporary_plaintext_audio",
      "destination": "local_audio_vault",
      "storageLocation": "app_private_no_backup_vault",
      "encryptionState": "aes_gcm_encrypted_at_rest",
      "ownerScope": "archive_and_account",
      "retention": "until_user_deletes",
      "deletionHandler": "audio_vault_and_account_deletion",
      "consentOrDisclosure": "direct_user_save",
      "analyticsProhibited": true,
      "externalProcessor": null,
      "productionCapability": "encrypted_audio_vault",
      "tests": ["apps/voicememory_mobile/test/services/privacy/audio_vault_service_test.dart"]
    },
    {
      "id": "remote_transcription",
      "dataCategory": "voice_recording",
      "origin": "controlled_audio_processing",
      "destination": "transcription_api",
      "storageLocation": "processor_transient_request",
      "encryptionState": "https_in_transit",
      "ownerScope": "authenticated_or_attested_capture",
      "retention": "processor_contract",
      "deletionHandler": "processor_and_account_deletion",
      "consentOrDisclosure": "remote_transcription_disclosure_required",
      "analyticsProhibited": true,
      "externalProcessor": "configured_transcription_provider",
      "productionCapability": "remote_transcription",
      "tests": ["apps/voicememory_mobile/test/remote_transcription_disclosure_test.dart"]
    },
    {
      "id": "validated_analysis",
      "dataCategory": "canonical_transcript_and_prior_evidence",
      "origin": "canonical_saved_moment",
      "destination": "analysis_api",
      "storageLocation": "validated_conclusion_and_exact_citations",
      "encryptionState": "https_in_transit_and_encrypted_local_persistence",
      "ownerScope": "archive_and_account",
      "retention": "until_user_deletes",
      "deletionHandler": "conclusion_and_account_deletion",
      "consentOrDisclosure": "product_and_privacy_disclosure",
      "analyticsProhibited": true,
      "externalProcessor": "configured_analysis_provider",
      "productionCapability": "validated_analysis",
      "tests": ["apps/voicememory_mobile/test/explainable_conclusion_validator_v1_test.dart"]
    },
    {
      "id": "encrypted_sync",
      "dataCategory": "encrypted_saved_moment_payload",
      "origin": "canonical_saved_moment_sync",
      "destination": "account_scoped_sync_api",
      "storageLocation": "server_ciphertext_and_client_local_store",
      "encryptionState": "client_side_aes_gcm_payload_encryption",
      "ownerScope": "archive_and_authenticated_account",
      "retention": "until_tombstone_or_account_deletion",
      "deletionHandler": "sync_tombstone_and_account_deletion",
      "consentOrDisclosure": "signed_in_sync_control",
      "analyticsProhibited": true,
      "externalProcessor": "ArchiveMe_backend",
      "productionCapability": "encrypted_account_sync",
      "tests": ["apps/voicememory_mobile/test/saved_moment_encrypted_sync_test.dart"]
    },
    {
      "id": "analytics",
      "dataCategory": "allowlisted_structural_metadata",
      "origin": "typed_analytics_facade",
      "destination": "configured_analytics_provider",
      "storageLocation": "provider_event_store",
      "encryptionState": "https_in_transit",
      "ownerScope": "installation_session_without_content_identifiers",
      "retention": "provider_configuration",
      "deletionHandler": "analytics_identity_reset_and_account_deletion",
      "consentOrDisclosure": "privacy_policy",
      "analyticsProhibited": false,
      "externalProcessor": "Firebase_Analytics",
      "productionCapability": "metadata_only_analytics",
      "tests": ["apps/voicememory_mobile/test/product_analytics_test.dart"]
    },
    {
      "id": "billing",
      "dataCategory": "subscription_state_and_store_transaction_metadata",
      "origin": "store_purchase",
      "destination": "RevenueCat_and_backend_entitlement_api",
      "storageLocation": "store_revenuecat_backend_and_local_cache",
      "encryptionState": "provider_transport_and_platform_storage",
      "ownerScope": "billing_identity",
      "retention": "store_and_provider_contract",
      "deletionHandler": "billing_identity_unlink_and_account_deletion",
      "consentOrDisclosure": "explicit_purchase_or_restore",
      "analyticsProhibited": true,
      "externalProcessor": "RevenueCat_and_app_store",
      "productionCapability": "revenuecat_subscription",
      "tests": ["apps/voicememory_mobile/test/subscriptions/default_subscription_repository_test.dart"]
    },
    {
      "id": "export",
      "dataCategory": "user_selected_archive_content",
      "origin": "canonical_saved_moment_store",
      "destination": "user_selected_share_target",
      "storageLocation": "temporary_app_private_export_then_share_sheet",
      "encryptionState": "format_and_destination_dependent",
      "ownerScope": "current_archive_and_account",
      "retention": "temporary_file_deleted_best_effort_after_handoff",
      "deletionHandler": "export_cleanup",
      "consentOrDisclosure": "explicit_user_export",
      "analyticsProhibited": true,
      "externalProcessor": "user_selected",
      "productionCapability": "user_initiated_export",
      "tests": []
    },
    {
      "id": "account_deletion",
      "dataCategory": "all_account_scoped_data_and_analytics_identity",
      "origin": "explicit_user_request",
      "destination": "local_and_backend_deletion_handlers",
      "storageLocation": "all_retained_stores",
      "encryptionState": "not_applicable",
      "ownerScope": "authenticated_account_and_local_archive",
      "retention": "deletion_outbox_until_completion",
      "deletionHandler": "account_deletion_coordinator",
      "consentOrDisclosure": "destructive_action_confirmation",
      "analyticsProhibited": true,
      "externalProcessor": "ArchiveMe_backend_and_billing_identity_unlink",
      "productionCapability": "authentication",
      "tests": []
    }
  ]
}
