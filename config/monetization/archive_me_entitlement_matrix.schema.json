{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archiveme.app/schemas/archive-me-entitlement-matrix.schema.json",
  "title": "ArchiveMe monetization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "revenueCat",
    "plans",
    "subscriptionStates",
    "customerFacingCopy",
    "capabilities",
    "usageMeters",
    "legacyMigrationRules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "revenueCat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalProEntitlementId",
        "acceptedLegacyEntitlementAliases",
        "legacyGrandfatheredProductIds",
        "currentOfferingPackageKinds",
        "blockedCurrentPackageKinds"
      ],
      "properties": {
        "canonicalProEntitlementId": { "type": "string", "minLength": 1 },
        "acceptedLegacyEntitlementAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "legacyGrandfatheredProductIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentOfferingPackageKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "blockedCurrentPackageKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["free", "pro", "legacyGrandfathered"]
          },
          "availableForNewPurchase": { "type": "boolean" }
        }
      }
    },
    "subscriptionStates": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 9,
      "items": {
        "enum": [
          "free",
          "trial",
          "active",
          "gracePeriod",
          "billingIssue",
          "expired",
          "revoked",
          "legacyGrandfathered",
          "unknown"
        ]
      }
    },
    "customerFacingCopy": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "accessClass",
          "expiryBehaviour",
          "offlineBehaviour",
          "copyKey"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "accessClass": {
            "enum": ["userOwned", "freeProof", "proMetered", "pro", "metered"]
          },
          "expiryBehaviour": { "type": "string", "minLength": 1 },
          "offlineBehaviour": { "type": "string", "minLength": 1 },
          "usageMeterId": { "type": "string", "minLength": 1 },
          "copyKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "usageMeters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit",
          "period",
          "productionConfigurationRequired"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "unit": { "enum": ["seconds", "requests"] },
          "period": { "enum": ["billingPeriod"] },
          "productionConfigurationRequired": { "type": "boolean" }
        }
      }
    },
    "legacyMigrationRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserveOriginalContentAccess",
        "preserveGeneratedOutputReadAccess",
        "doNotConsumeFreeProofFromLegacyCounters",
        "honourActiveLegacyEntitlementAliases",
        "honourVerifiedLifetimePurchasersAsLegacyGrandfathered",
        "allowNewLifetimePurchases"
      ],
      "properties": {
        "preserveOriginalContentAccess": { "const": true },
        "preserveGeneratedOutputReadAccess": { "const": true },
        "doNotConsumeFreeProofFromLegacyCounters": { "const": true },
        "honourActiveLegacyEntitlementAliases": { "const": true },
        "honourVerifiedLifetimePurchasersAsLegacyGrandfathered": { "const": true },
        "allowNewLifetimePurchases": { "const": false }
      }
    }
  }
}
