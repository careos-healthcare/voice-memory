# Copy to `.env` for local debug runs (not bundled in release).
BACKEND_URL=http://127.0.0.1:3000

# Compile-time billing switches. Pass these with --dart-define or
# --dart-define-from-file; Flutter does not read them from this file at runtime.
USE_WEB_STRIPE_CHECKOUT=false
ALLOW_IOS_WEB_STRIPE_CHECKOUT=false
ALLOW_ANDROID_WEB_STRIPE_CHECKOUT=false
