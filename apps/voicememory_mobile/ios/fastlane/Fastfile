default_platform(:ios)

require "tmpdir"
require "shellwords"

ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
ENV["FASTLANE_OPT_OUT_USAGE"] = "1"
ENV["FLUTTER_SUPPRESS_ANALYTICS"] = "true"
ENV["COCOAPODS_DISABLE_STATS"] = "true"

platform :ios do
  desc "Clean, validate, test, build, and audit the iOS paid release"
  lane :verify do
    app_root = File.expand_path("../..", __dir__)
    Dir.chdir(app_root) do
      sh("tool/validate_revenuecat_configuration.sh", "--platform", "ios", "--paid")
      sh("tool/validate_release_version.sh")
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
      sh("dart", "format", "--output=none", "--set-exit-if-changed", "lib", "test", "integration_test")
      sh("flutter", "analyze", "--fatal-infos", "--fatal-warnings")
      sh(
        "flutter",
        "test",
        "test/revenuecat_configuration_test.dart",
        "test/revenuecat_resilience_test.dart",
        "test/revenuecat_offline_cache_policy_test.dart",
        "test/subscriptions/default_subscription_repository_test.dart",
        "test/paywall_purchase_flow_test.dart",
        "test/paywall_restore_test.dart",
        "test/restore_purchases_flow_test.dart"
      )
      sh(
        "flutter",
        "build",
        "ios",
        "--release",
        "--no-codesign",
        "--dart-define=REVENUECAT_PURCHASES_ENABLED=true",
        "--dart-define=REVENUECAT_IOS_API_KEY=#{ENV.fetch("REVENUECAT_IOS_API_KEY")}"
      )
      sh(
        "tool/audit_v1_permissions.sh",
        "--ios-only",
        "--ios-app",
        "build/ios/iphoneos/Runner.app",
        "--ios-entitlements",
        "ios/Runner/Runner-Release.entitlements"
      )
    end
  end

  desc "Verify and upload a production-signed IPA to TestFlight"
  lane :beta do |options|
    unless ENV["CI"] == "true" && ENV["ARCHIVEME_PROTECTED_RELEASE"] == "true"
      UI.user_error!("beta is CI/protected-environment only")
    end
    %w[
      APP_STORE_CONNECT_API_KEY
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
    ].each do |name|
      UI.user_error!("Missing #{name}") if ENV[name].to_s.empty?
    end

    app_root = File.expand_path("../..", __dir__)
    ipa = options[:ipa] || Dir[File.join(app_root, "build/ios/ipa/*.ipa")].first
    UI.user_error!("Signed IPA not found") unless ipa && File.file?(ipa)

    Dir.chdir(app_root) do
      sh("tool/validate_revenuecat_configuration.sh", "--platform", "ios", "--paid")
    end
    Dir.mktmpdir("archiveme-ipa") do |dir|
      sh("unzip", "-q", ipa, "-d", dir)
      app = Dir[File.join(dir, "Payload/*.app")].first
      UI.user_error!("IPA does not contain a Runner app") unless app
      version_line = File.readlines(File.join(app_root, "pubspec.yaml"))
        .find { |line| line.start_with?("version:") }
        .to_s
        .split(":", 2)
        .last
        .to_s
        .strip
      expected_version, expected_build = version_line.split("+", 2)
      actual_version = sh(
        "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' " \
        "#{Shellwords.escape(File.join(app, "Info.plist"))}",
        log: false
      ).strip
      actual_build = sh(
        "/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' " \
        "#{Shellwords.escape(File.join(app, "Info.plist"))}",
        log: false
      ).strip
      unless actual_version == expected_version && actual_build == expected_build
        UI.user_error!("IPA version/build does not match pubspec.yaml")
      end
      signature = sh("codesign -dv --verbose=4 #{Shellwords.escape(app)} 2>&1", log: false)
      if signature.include?("Apple Development") || signature.include?("Signature=adhoc")
        UI.user_error!("Refusing development- or ad-hoc-signed IPA")
      end
      entitlements = File.join(dir, "entitlements.plist")
      sh(
        "codesign -d --entitlements :- #{Shellwords.escape(app)} " \
        "> #{Shellwords.escape(entitlements)} 2>/dev/null"
      )
      get_task_allow = sh(
        "/usr/libexec/PlistBuddy -c 'Print :get-task-allow' #{Shellwords.escape(entitlements)} 2>/dev/null || true",
        log: false
      ).strip
      UI.user_error!("Refusing debuggable IPA") if get_task_allow == "true"
      Dir.chdir(app_root) do
        sh(
          "tool/audit_v1_permissions.sh",
          "--ios-only",
          "--ios-app",
          app
        )
      end
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )
    upload_to_testflight(
      ipa: ipa,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build a locally signed Genesis IPA without profile sync or upload"
  lane :genesis do |options|
    requires_signing = !options[:dry_run] && !options[:skip_signing]
    if requires_signing
      identities = sh("security find-identity -v -p codesigning", log: false)
      UI.user_error!("No local Apple code-signing identity is installed") if identities.include?("0 valid identities")
      export_options = ENV["GENESIS_IOS_EXPORT_OPTIONS_PLIST"].to_s
      if export_options.empty? || !File.file?(export_options)
        UI.user_error!("GENESIS_IOS_EXPORT_OPTIONS_PLIST must reference a local manual-signing plist")
      end
    end

    script = File.expand_path("../../../../scripts/build/build_genesis.sh", __dir__)
    args = ["--targets", "ios"]
    args << "--dry-run" if options[:dry_run]
    args << "--skip-signing" if options[:skip_signing]
    args += ["--source-date-epoch", options[:source_date_epoch].to_s] if options[:source_date_epoch]
    args << "--allow-dirty" if options[:allow_dirty]
    sh(script, *args)
  end
end
