default_platform(:mac)

ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
ENV["FASTLANE_OPT_OUT_USAGE"] = "1"
ENV["FLUTTER_SUPPRESS_ANALYTICS"] = "true"
ENV["COCOAPODS_DISABLE_STATS"] = "true"

platform :mac do
  desc "Build a locally signed Genesis DMG without profile sync or upload"
  lane :genesis do |options|
    requires_signing = !options[:dry_run] && !options[:skip_signing]
    if requires_signing
      identity = ENV["GENESIS_MACOS_SIGN_IDENTITY"].to_s
      UI.user_error!("GENESIS_MACOS_SIGN_IDENTITY must name a local keychain identity") if identity.empty?

      identities = sh("security find-identity -v -p codesigning", log: false)
      UI.user_error!("The requested local signing identity is unavailable") unless identities.include?(identity)
    end

    script = File.expand_path("../../../../scripts/build/build_genesis.sh", __dir__)
    args = ["--targets", "macos"]
    args << "--dry-run" if options[:dry_run]
    args << "--skip-signing" if options[:skip_signing]
    args += ["--source-date-epoch", options[:source_date_epoch].to_s] if options[:source_date_epoch]
    args << "--allow-dirty" if options[:allow_dirty]
    sh(script, *args)
  end
end
