# Generated and machine-local artifacts inside this vendored package.
# The repository-root .gitignore only anchors its Flutter rules at
# apps/mobile/, so they have to be repeated here.

.dart_tool/
build/
.flutter-plugins-dependencies

# Flutter platform scaffolding regenerated by the toolchain on every build.
# The desktop .plugin_symlinks entries are absolute symlinks into the local
# pub cache and are broken on any other machine.
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Machine-local Android SDK paths.
android/local.properties
android/.gradle/
