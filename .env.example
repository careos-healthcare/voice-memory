# Auth code email — required in production for sign-in delivery
RESEND_API_KEY=
EMAIL_FROM=VoiceMemory <onboarding@resend.dev>

# Auth — required in production for signed sessions (min 32 random bytes)
AUTH_SECRET=

# Public site URL for production checks and absolute links
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# OpenAI — required for /api/transcribe and /api/analyze; optional for atmosphere API
OPENAI_API_KEY=

# Atmosphere image API — opt-in; local canvas fallback used when false or key missing
VOICEMEMORY_ENABLE_ATMOSPHERE_API=false

# Auth code + account storage — Postgres required before serious multi-device testing.
# Without DATABASE_URL, production uses ephemeral in-memory auth (same server instance only).
# DATABASE_URL=

# Optional: protect /debug routes in production (?debug_token=… sets an 8h cookie)
# DEBUG_ACCESS_TOKEN=

# Optional: directory for encrypted sync blobs (development / persistent hosts only)
# SYNC_DATA_DIR=
