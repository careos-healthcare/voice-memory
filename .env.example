# Live conversation (Gemini via backend WebSocket proxy)
VOICEMEMORY_ENABLE_LIVE_CONVERSATION=false

# Theory tracking (insight-science layer on mobile)
VOICEMEMORY_ENABLE_THEORY_TRACKING=false

# Professional coach tier (hidden until billing ships)
VOICEMEMORY_ENABLE_PROFESSIONAL_COACH=false
COACH_CONSENT_HMAC_SECRET=

# RevenueCat coach seat (per-seat professional dashboard)
# Dashboard: create entitlement `professional_coach_per_seat`, product, and offering.
REVENUECAT_COACH_SEAT_ENTITLEMENT_ID=professional_coach_per_seat
REVENUECAT_COACH_SEAT_PRODUCT_ID=
REVENUECAT_COACH_SEAT_OFFERING_ID=

# Gemini (live audio + fact ledger embeddings)
VOICEMEMORY_EMBEDDING_MODEL=text-embedding-004

# Neon DB
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_SSL_CA_BUNDLE=

# Resend (archiveme.app — see docs/RESEND_DOMAIN_AUTH.md)
RESEND_API_KEY=
EMAIL_FROM=ArchiveMe <noreply@archiveme.app>

# Marketing site canonical URL (web sitemap, Stripe redirects, auth links)
NEXT_PUBLIC_SITE_URL=https://archiveme.app
NEXT_PUBLIC_APP_URL=https://archiveme.app

# Auth
AUTH_SECRET=
EMAIL_DISABLED=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_LIVE_PROOF=

# RevenueCat (web session entitlement fallback for mobile store purchases)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro

# Redis
REDIS_URL=
