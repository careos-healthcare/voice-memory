# Auth code email — required in production unless EMAIL_DISABLED=true
RESEND_API_KEY=
EMAIL_FROM=ArchiveMe <onboarding@resend.dev>
# EMAIL_DISABLED=true

# Auth — required in production for signed sessions (min 32 random bytes)
AUTH_SECRET=

# Public site URL for production checks and absolute links
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# OpenAI — required for /api/transcribe and /api/analyze; optional for atmosphere API
OPENAI_API_KEY=

# Gemini Live — server-only; required for /api/live-audio/session (never ship to mobile)
# GEMINI_API_KEY=
# VOICEMEMORY_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# VOICEMEMORY_GEMINI_KILL_SWITCH=true
# VOICEMEMORY_DAILY_LIVE_AUDIO_LIMIT=
# VOICEMEMORY_MINUTE_LIVE_AUDIO_LIMIT=

# OpenAI route limits (optional overrides)
# VOICEMEMORY_DAILY_TRANSCRIBE_LIMIT=
# VOICEMEMORY_MINUTE_TRANSCRIBE_LIMIT=
# VOICEMEMORY_DAILY_ANALYZE_LIMIT=
# VOICEMEMORY_MINUTE_ANALYZE_LIMIT=
# VOICEMEMORY_MAX_RECORDING_SECONDS=120

# OpenAI daily spend caps (USD) — requires DATABASE_URL in production
# VOICEMEMORY_OPENAI_GLOBAL_DAILY_BUDGET_USD=25
# VOICEMEMORY_OPENAI_IP_DAILY_BUDGET_USD=1.5
# VOICEMEMORY_OPENAI_DEVICE_DAILY_BUDGET_USD=2
# VOICEMEMORY_OPENAI_USER_DAILY_BUDGET_USD=2
# VOICEMEMORY_OPENAI_ROUTE_TRANSCRIBE_DAILY_USD=12
# VOICEMEMORY_OPENAI_ROUTE_ANALYZE_DAILY_USD=8
# VOICEMEMORY_OPENAI_ROUTE_ATMOSPHERE_DAILY_USD=4
# VOICEMEMORY_OPENAI_KILL_SWITCH=true

# Atmosphere image API — opt-in; local canvas fallback used when false or key missing
VOICEMEMORY_ENABLE_ATMOSPHERE_API=false

# GPT-5 Archive Synthesis V2 (POST /api/archive-synthesis)
# synthesisType: monthly | milestone | deep_dive | historian
# VOICEMEMORY_ENABLE_GPT5_ARCHIVE_SYNTHESIS=false
# VOICEMEMORY_ARCHIVE_SYNTHESIS_MODEL=gpt-4o-mini

# Anonymized semantic cluster naming (POST /api/cluster-synthesis)
# VOICEMEMORY_CLUSTER_SYNTHESIS_MODEL=gpt-4o-mini

# Ephemeral anonymized counterfactual trajectories (POST /api/life-simulator)
# VOICEMEMORY_LIFE_SIMULATOR_MODEL=gpt-4o-mini

# Ephemeral anonymized behavioral experiments (POST /api/action-plan-generator)
# VOICEMEMORY_ACTION_PLAN_GENERATOR_MODEL=gpt-4o-mini

# Auth code + encrypted sync — Postgres required before real tester onboarding.
# When set, auth codes, sessions, and encrypted sync blobs persist across deploys.
DATABASE_URL=

# Without DATABASE_URL in production, auth and sync fall back to ephemeral in-memory storage
# (single serverless instance only — not suitable for multi-device testing).

# Privacy-safe unit economics (activate only after migration + reviewed pricing catalog).
# Production enablement requires durable DATABASE_URL and a base64/base64url key decoding to 32+ bytes.
# Keep old versioned keys configured during subject-key rotation.
# VOICEMEMORY_UNIT_ECONOMICS_ENABLED=false
# VOICEMEMORY_UNIT_ECONOMICS_HMAC_ACTIVE_VERSION=1
# VOICEMEMORY_UNIT_ECONOMICS_HMAC_KEY_V1=
# Explicit local-only fallback; rejected as a production strategy.
# VOICEMEMORY_UNIT_ECONOMICS_ALLOW_DEV_FALLBACK=false
# Fail when an occurred-at resource has no immutable catalog price (recommended).
# VOICEMEMORY_UNIT_ECONOMICS_PRICING_REQUIRED=true
# Optional path override for the versioned catalog activation CLI.
# VOICEMEMORY_UNIT_ECONOMICS_PRICING_CATALOG_PATH=config/unit-economics/pricing-catalog.v1.json
# Integer thresholds: basis points and micro-USD (1 USD = 1,000,000 micro-USD).
# VOICEMEMORY_UNIT_ECONOMICS_MIN_MARGIN_BPS=2000
# VOICEMEMORY_UNIT_ECONOMICS_MAX_DAILY_COGS_MICRO_USD=5000000
# VOICEMEMORY_UNIT_ECONOMICS_MAX_ABSOLUTE_LOSS_MICRO_USD=1000000
# VOICEMEMORY_UNIT_ECONOMICS_MAX_RECONCILIATION_DAYS=31
# Required by Vercel cron. Use a high-entropy server-only value.
# CRON_SECRET=

# Stripe — all four required to enable checkout (otherwise fail closed)
# See docs/STRIPE_LIVE_SETUP.md for products, webhooks, and Stripe CLI testing.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# NEXT_PUBLIC_APP_URL must match your deployed origin for checkout redirects
# After manual webhook proof in staging: STRIPE_WEBHOOK_LIVE_PROOF=1

# RevenueCat — server-only secret key used to verify protected backend actions.
# Never use an iOS/Android public SDK key here or expose this as NEXT_PUBLIC_*.
REVENUECAT_SECRET_API_KEY=
# High-entropy Authorization token configured in the RevenueCat webhook dashboard.
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# Optional: protect /debug and /demo routes in production (?debug_token=… sets an 8h cookie)
# DEBUG_ACCESS_TOKEN=
# VOICEMEMORY_ENABLE_DEMO=false
# VOICEMEMORY_FOUNDER_EMAILS=you@example.com

# Capture attest hardening (optional)
# VOICEMEMORY_CAPTURE_MAX_USES=500
# VOICEMEMORY_DAILY_ATTEST_LIMIT=
# VOICEMEMORY_MINUTE_ATTEST_LIMIT=
# VOICEMEMORY_DAILY_ATMOSPHERE_LIMIT=
# VOICEMEMORY_MINUTE_ATMOSPHERE_LIMIT=

# Server-authoritative billing-period allowances. REQUIRED in production for
# each plan/meter used by an expensive route. Values must be reviewed
# non-negative integer units; there are deliberately no production defaults.
# VOICEMEMORY_USAGE_ALLOWANCES_JSON=
# Production also requires explicit VOICEMEMORY_DAILY_* and
# VOICEMEMORY_MINUTE_* limits for every enabled expensive route kind.

# Optional: directory for encrypted sync blobs (development / persistent hosts only)
# SYNC_DATA_DIR=

# --- Docker Compose (docker-compose.yml) ---
# Telemetry / live-audio backend stack — copy to .env before: docker compose up -d
# REDIS_URL=redis://redis-cluster:6379/0
# LOG_LEVEL=info
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# Host-level sysctl (run on Linux VM before high-concurrency deploy):
#   sudo sysctl -w net.core.somaxconn=32768
#   sudo sysctl -w net.ipv4.tcp_tw_reuse=1
#   sudo sysctl -w net.ipv4.ip_local_port_range="1024 65535"
#   sudo sysctl -w fs.file-max=2097152
