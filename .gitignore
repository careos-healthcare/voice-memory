# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor / native build artifacts (commit ios/ and android/ sources, not caches)
ios/App/DerivedData/
ios/App/Pods/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Next.js production build output (contains webpack cache packs above GitHub's file size limit)
/.backend-release/

# Flutter mobile app
apps/voicememory_mobile/.dart_tool/
apps/voicememory_mobile/build/
apps/voicememory_mobile/.flutter-plugins-dependencies

# Fetched and generated native dependencies (restored by tool/fetch_llama_cpp.sh)
apps/voicememory_mobile/third_party/llama.cpp/
apps/voicememory_mobile/native/ios/

# Flutter desktop plugin scaffolding regenerated by the toolchain on every build
apps/voicememory_mobile/linux/flutter/ephemeral/
apps/voicememory_mobile/macos/Flutter/ephemeral/
apps/voicememory_mobile/windows/flutter/ephemeral/

# local data
/data/*.json
!/data/.gitkeep
.data/
.env*.local

# Flutter test temp files
apps/voicememory_mobile/test/tmp/

# Flutter test-generated journal/prefs in mobile app cwd (must not pollute git or exports)
apps/voicememory_mobile/*_journal.json
apps/voicememory_mobile/*_prefs.json
apps/voicememory_mobile/_journal.json
apps/voicememory_mobile/_prefs.json

# Gate and release-suite run logs, regenerated on every run rather than reviewed
/release/evidence/
