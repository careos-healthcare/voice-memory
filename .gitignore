# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# turborepo per-workspace task caches and logs (recreated by every `turbo run`)
.turbo/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary build error logs and local debugging output (repository root)
/vm_fail.txt
/*_fail.txt
/*build-error*.txt
/*build_error*.txt
/*build-fail*.txt
/*compile-fail*.txt
/*compile_error*.txt
/*debug-output*.txt
/*debug_output*.txt

# Environment files — never commit secrets; only .env.example is tracked
.env*
!.env.example
**/.env*
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor / native build artifacts (commit ios/ and android/ sources, not caches)
ios/App/DerivedData/
ios/App/Pods/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Next.js production build output (contains webpack cache packs above GitHub's file size limit)
/.backend-release/

# Flutter mobile app
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins-dependencies

# Generated native build artifacts (llama.cpp CMake caches removed)
apps/mobile/native/ios/

# CMake build artifacts, caches, and out-of-tree build dirs
**/.cmake/
*.cmake
CMakeCache.txt
CMakeFiles/
cmake-build-*/
**/cmake_install.cmake
**/CTestTestfile.cmake
**/Testing/
Makefile
!**/Makefile.am

# Flutter-generated CMake plugin lists (keep tracked)
!apps/mobile/linux/flutter/generated_plugins.cmake
!apps/mobile/macos/Flutter/generated_plugins.cmake
!apps/mobile/windows/flutter/generated_plugins.cmake

# Flutter desktop plugin scaffolding regenerated by the toolchain on every build
apps/mobile/linux/flutter/ephemeral/
apps/mobile/macos/Flutter/ephemeral/
apps/mobile/windows/flutter/ephemeral/

# local data
/data/*.json
!/data/.gitkeep
.data/

# Flutter test temp files
apps/mobile/test/tmp/

# Flutter test-generated journal/prefs in mobile app cwd (must not pollute git or exports)
apps/mobile/*_journal.json
apps/mobile/*_prefs.json
apps/mobile/_journal.json
apps/mobile/_prefs.json
*.tsbuildinfo
