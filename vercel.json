{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/unit-economics/reconcile",
      "schedule": "15 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/debug/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
