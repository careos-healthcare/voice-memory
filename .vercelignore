# Keep Vercel uploads web-only — exclude mobile app and large non-web assets.
apps/voicememory_mobile/
apps/voicememory_mobile/**

# Local build artifacts (Vercel rebuilds on platform)
.next/
node_modules/

# Docs and planning artifacts not needed for runtime
*.md
!README.md

# Test and audit artifacts
**/test/tmp/
**/*.test.ts.snap

# Native/mobile tooling outside web deploy
android/
ios/
capacitor.config.*
