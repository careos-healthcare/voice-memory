{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./packages/shared/*"
      ],
      "@/lib/*": [
        "./packages/shared/lib/*"
      ],
      "@/types/*": [
        "./packages/shared/types/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile",
    "apps/web/.next",
    "apps/api/.next",
    "scripts"
  ]
}
